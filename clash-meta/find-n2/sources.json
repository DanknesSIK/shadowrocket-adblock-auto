  },
  "pikpak": {
    "repo": "blackmatrix7/ios_rule_script",
    "ref": "master",
    "path": "rule/Clash/PikPak/PikPak.yaml"
  },
  "consumer": {
    "refreshSeconds": 86400,
    "adRule": "DOMAIN,adx.ads.heytapmobi.com,REJECT",
    "pikpakGroup": "PikPak-Auto",
    "pikpakRequired": [
      "DOMAIN-KEYWORD,mypikpak",
      "DOMAIN-SUFFIX,pikpak.me"
    ],
    "healthUrl": "https://mypikpak.com/en-US/faq",
    "healthStatus": 200,
    "testIntervalSeconds": 1800,
    "toleranceMs": 150,
    "excludeFilter": "(?i)^(DIRECT|REJECT(-DROP)?|PASS|COMPATIBLE)$|剩余流量|套餐到期|距离下次重置|重置时间|^网址[:：]|^回家页[:：]"
  }
}
